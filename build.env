# ImgFlash 构建配置
# 修改此文件后重新构建即可生效

# --- 目标架构（amd64 / arm64） ---
ARCH=amd64

# --- Debian 仓库 ---
DEBIAN_MIRROR=https://ftp.debian.org/debian
DEBIAN_SUITE=trixie

# --- ISO 元数据 ---
VOLUME_LABEL=IMGFLASH

# --- 内核模块 ---
MOD_FILESYSTEM="squashfs isofs loop"
MOD_NLS="nls_cp437 nls_ascii nls_utf8"
MOD_ATA="ahci ata_piix ata_generic"
MOD_USB="xhci-hcd xhci-pci ehci-hcd ehci-pci usb-storage uas"
MOD_CDROM="sr_mod sd_mod cdrom"
MOD_INPUT="hid usbhid"
MOD_NVME="nvme"
MOD_VIRT="virtio virtio_blk virtio_pci virtio_scsi"
MOD_EMMC="mmc_core mmc_block sdhci sdhci-pci sdhci-acpi cqhci"
MOD_EMMC_CARDREADER="rtsx_pci_sdmmc rtsx_usb_sdmmc tifm_sd toshsd via-sdmmc cb710-mmc"

# --- 可选模块 ---
# 大量 pata_* / sata_*（老式 PATA/SATA 控制器，现代设备走 AHCI 无需）
# firewire-sbp2（火线存储）
# xen-blkfront xen-scsifront（Xen 虚拟化）
# pcmcia_core yenta_socket pata_pcmcia（PCMCIA 存储）
# MOD_EMMC_USB="vub300 ushc wbsd"（USB 外接读卡器）

# --- 可选模块开关（设为 0 禁用，设为 1 启用） ---
INCLUDE_NVME=1
INCLUDE_VIRT=1

# --- 启动菜单超时（秒） ---
BOOT_TIMEOUT=0

# --- 内核启动参数 ---
KERNEL_PARAMS=quiet

# --- 启动扫描超时（秒） ---
SCAN_TIMEOUT=10

# --- 启用Secure Boot ---
ENABLE_SECURE_BOOT=0

# --- 压缩级别 ---
ZSTD_LEVEL=19

# --- 安装器模式（1=TUI / 0=Shell脚本） ---
USE_TUI=1

# --- 自动扩容（dd 后末分区原地增长） ---
# GROW_ENABLED 是构建期能力开关（工具打入 initramfs）；grow.conf enabled= 是运行期策略开关
GROW_ENABLED=1
GROW_PART=auto             # auto | 分区号（运行策略，进 grow.conf）
GROW_TOOLS="ext4,xfs,ntfs" # 打包哪些 fs 工具（构建能力，纯 build 期，永不进 grow.conf）
# 语义边界：GROW_TOOLS 仅指 filesystem resize 能力；sfdisk/mkswap/partx 是 grow 核心依赖，
# GROW_ENABLED=1 时无条件打包，永不作为 GROW_TOOLS 条目